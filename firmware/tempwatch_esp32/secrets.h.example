// คัดลอกไฟล์นี้เป็น secrets.h แล้วใส่ค่าจริง
//   secrets.h.example  →  secrets.h
//
// secrets.h อยู่ใน .gitignore จะไม่ถูก commit (รหัส Wi-Fi / IP เครื่องเรา)

#ifndef TEMPWATCH_SECRETS_H
#define TEMPWATCH_SECRETS_H

#define WIFI_SSID "YourWiFiName"
#define WIFI_PASSWORD "YourWiFiPassword"

// IP ของ PC ที่รัน ASP.NET Core — ห้ามใช้ localhost / 127.0.0.1
// เพราะบน ESP32 ค่านั้นหมายถึงตัวบอร์ดเอง ไม่ใช่เครื่อง PC
// ดูบน Windows: ipconfig → IPv4 Address ของอะแดปเตอร์ Wi-Fi
#define API_HOST "192.168.1.10"
#define API_PORT 5078

#endif
